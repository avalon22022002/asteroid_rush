{
  "name": "Asteroid Rush Dev Container",
  "dockerComposeFile": "./docker-compose.yaml",
  "service": "asteroid-rush-dev",
  "workspaceFolder": "/workspace/asteroid_rush",
  // Auto-detect WSL distro for audio (see docker-compose.yaml)
  // - Windows only
  // - Path is unquoted: VS Code passes embedded quotes through literally, breaking -File
  // - Assumes the workspace path has no spaces
  // - "|| cd ." is a no-op fallback elsewhere (cmd.exe doesn't know "|| true")
  "initializeCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ${localWorkspaceFolder}\\.devcontainer\\detect-wsl-distro.ps1 || cd .",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer", // for rust intellisense
        "vadimcn.vscode-lldb" // for debugging via lldb
      ],
      "settings": {
        "editor.formatOnSave": true,
        "rust-analyzer.checkOnSave.enable": true,
        "rust-analyzer.cargo.buildScripts.enable": true,
        "rust-analyzer.procMacro.enable": true,
        "git.openRepositoryInParentFolders": "always"
      }
    }
  },
  // Runs once the container is created:
  // - rustc --version : sanity check the toolchain is there
  // - cargo --version : same, for cargo
  // - cargo fetch      : pre-downloads crates so the first build is fast
  "postCreateCommand": "rustc --version && cargo --version && cargo fetch"
}